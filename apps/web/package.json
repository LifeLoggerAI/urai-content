{
  "name": "urai-content-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "smoke:routes": "tsx scripts/smoke-routes.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@next/env": "15.5.27",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.3",
    "eslint-config-next": "15.5.27",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "minimatch@^3.0.0": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@^5.0.0": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@^10.0.0": {
      "brace-expansion": "5.0.12"
    },
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.5",
    "js-yaml": "4.3.2",
    "glob": {
      "brace-expansion": "2.1.7"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "source-map-js": "1.2.2"
  }
}
